<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:sample="CommonUX.Samples.TypedNavigation" xmlns:common="CommonUX.UIToolkit" editor-extension-mode="False">
    <sample:SampleStackView name="menu-stack" stack-id="Menu" class="sample-stack">
        <sample:SampleScreenView name="home-screen" screen-id="Home" default-focus="open-settings" class="sample-screen home-screen">
            <ui:VisualElement class="home-card">
                <ui:Label text="COMMONUX / TYPED NAVIGATION" class="eyebrow" />
                <ui:Label text="Your UI. Shared behavior." class="title" />
                <ui:Label text="The enum IDs below belong to this sample. CommonUX owns the screen stack, modal input boundary, and focus restoration." class="description" />
                <ui:VisualElement class="identity-row">
                    <ui:Label text="Layer: Menu" class="badge" />
                    <ui:Label text="Screen: Home" class="badge" />
                </ui:VisualElement>
                <ui:Button name="play-demo" text="Play demo" class="primary-button" />
                <ui:Button name="open-settings" text="Open settings" class="secondary-button" />
                <ui:Label name="demo-status" text="Ready. Open settings to try the modal." class="status" />
                <ui:Label text="Keyboard: Tab / Enter / Escape. Gamepad: Navigate / Submit / Cancel." class="hint" />
                <ui:Label text="ACTIVE SCREEN COMMANDS" class="action-bar-heading" />
                <common:ActionBar name="home-action-bar" class="sample-action-bar" />
            </ui:VisualElement>
        </sample:SampleScreenView>
    </sample:SampleStackView>
    <sample:SampleStackView name="modal-stack" stack-id="Modal" class="sample-stack">
        <sample:SampleScreenView name="settings-screen" screen-id="Settings" modal="true" blocks-gameplay-input="true" default-focus="volume-slider" class="sample-screen modal-screen">
            <ui:VisualElement class="settings-card">
                <ui:Label text="LAYER: MODAL / SCREEN: SETTINGS" class="eyebrow" />
                <ui:Label text="Settings" class="settings-title" />
                <ui:Label text="Change the value, close this screen, then open it again. Its view stays alive while inactive." class="description" />
                <ui:Slider name="volume-slider" label="Demo volume" low-value="0" high-value="100" value="50" />
                <ui:Label name="volume-value" text="50%" class="volume-value" />
                <ui:Button name="close-settings" text="Save and close" class="primary-button" />
                <ui:Label text="Escape / Cancel also closes this modal. Focus returns to the menu." class="hint" />
                <ui:Label text="ACTIVE SCREEN COMMANDS" class="action-bar-heading" />
                <common:ActionBar name="settings-action-bar" class="sample-action-bar" />
            </ui:VisualElement>
        </sample:SampleScreenView>
    </sample:SampleStackView>
</ui:UXML>
